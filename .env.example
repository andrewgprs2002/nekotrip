# Supabase (required for v0.3 collaboration)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Maps Platform
# Required: Maps JavaScript API + Places API (New)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional in local development. If empty, NekoTrip uses DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
